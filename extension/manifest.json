{
  "manifest_version": 3,
  "name": "Arc for Chrome",
  "version": "0.9.0",
  "description": "Spotlight-style search for open tabs, bookmarks, history and the web.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "history",
    "bookmarks"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Arc Search"
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Command+T"
      },
      "description": "Open Spotlight-style search"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
