{
  "manifest_version": 3,
  "name": "Arc for Chrome",
  "version": "0.24.1",
  "description": "__MSG_spotlight_style_search_for_open_tabs_bookmarks_history_and_the_web__",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "history",
    "bookmarks",
    "search",
    "sessions",
    "storage",
    "clipboardWrite",
    "alarms",
    "tabGroups",
    "favicon",
    "sidePanel"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_open_arc_search__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Command+T"
      },
      "description": "__MSG_open_spotlight_style_search__"
    },
    "open-commands": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Command+E"
      },
      "description": "__MSG_open_browser_commands__"
    },
    "previous-tab": {
      "suggested_key": {
        "mac": "Option+Shift+Q",
        "default": "Alt+Shift+Q"
      },
      "description": "__MSG_switch_to_previous_tab__"
    },
    "edit-address": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+L"
      },
      "description": "__MSG_edit_the_current_url_in_the_command_bar__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "default_locale": "en"
}
