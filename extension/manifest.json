{
  "manifest_version": 3,
  "name": "Arc for Chrome",
  "version": "0.3.0",
  "description": "A calm sidebar with vertical tabs, favorites and spaces powered by Chrome tab groups.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Arc for Chrome"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open the sidebar"
    },
    "toggle-pin": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Pin or unpin current tab"
    },
    "previous-tab": {
      "description": "Previous tab"
    },
    "next-tab": {
      "suggested_key": {
        "default": "Alt+Shift+Right",
        "mac": "Alt+Shift+Right"
      },
      "description": "Next tab"
    },
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open Spotlight-style search"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
